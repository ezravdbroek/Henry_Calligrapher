---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TrustedBy from '../components/TrustedBy.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Section from '../components/Section.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactBanner from '../components/ContactBanner.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import Button from '../components/Button.astro';
import { tagline } from '../data/content';
import { img } from '../lib/images';

const wordmark = img('henry-wordmark-alpha.png');

const description =
  'Hand-lettered wedding stationery, live event calligraphy, engraving and hot foil by Isha Henry-Hament, calligrapher based in Breda, the Netherlands.';

/* Carried over from the original site. `areaServed` and the hot foiling wording follow the
   positioning line in the masthead, so the structured data says the same as the page. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Henry Calligraphy',
  description,
  url: 'https://henrycalligraphy.com/',
  founder: { '@type': 'Person', name: 'Isha Henry-Hament' },
  address: { '@type': 'PostalAddress', addressLocality: 'Breda', addressCountry: 'NL' },
  areaServed: ['Netherlands', 'Belgium', 'Luxembourg'],
  knowsAbout: [
    'Copperplate calligraphy',
    'Wedding stationery',
    'Live event calligraphy',
    'Engraving',
    'Hot foiling',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      'Bespoke wedding stationery',
      'Live event calligraphy',
      'Engraving',
      'Hot foiling',
      'Private calligraphy lessons',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};
---

<Layout
  title="Henry Calligraphy — Bespoke Copperplate Calligraphy in Breda"
  description={description}
  jsonLd={jsonLd}
>
  {/*
    The landing page opens exactly as the original site did: wordmark, accent rule, positioning
    line, statement. The photographic hero that used to sit below it has been dropped at the
    client's request — this block is the hero now, with the two calls to action from that
    version carried over so the page still offers a way in.

    The location reads "Netherlands, Benelux & Beyond" rather than the original's "in Breda":
    the studio's reach was widened during this round of feedback.
  */}
  <section class="border-b border-foreground/10">
    <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:px-6 sm:py-24 lg:py-32" data-reveal>
      <Image
        src={wordmark}
        alt="Henry Calligraphy"
        widths={[440, 880]}
        sizes="(min-width: 1024px) 18rem, (min-width: 640px) 16rem, 14rem"
        class="mx-auto w-56 sm:w-64 lg:w-72"
        loading="eager"
      />
      <div class="mx-auto mt-8 h-px w-12 bg-accent" aria-hidden="true"></div>
      <p
        class="mx-auto mt-8 max-w-2xl text-balance font-sans text-eyebrow uppercase tracking-[0.24em] text-muted-foreground"
      >
        {/* Non-breaking space before the separator: without it the line breaks in front of the
            middot and the second line opens on a stray dot. */}
        Bespoke copperplate calligraphy&nbsp;· Netherlands, Benelux &amp; Beyond
      </p>
      <h1 class="mx-auto mt-7 max-w-3xl text-balance font-serif text-display">{tagline}</h1>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <Button href="/petalia" variant="accent" size="smMd">Discover Pétalia</Button>
        <Button href="/contact" variant="outline" size="smMd">Commission inquiry</Button>
      </div>
    </div>
  </section>
  <TrustedBy />
  <ServiceCards />

  <Section>
    <div class="flex flex-col gap-14 lg:gap-20">
      <FeatureSplit
        eyebrow="At your event"
        title="Live calligraphy"
        file="live-waxseal.jpg"
        alt="Live calligraphy — pouring a wax seal onto a hand-lettered envelope"
        objectPosition="object-[50%_68%]"
      >
        On-site at your event: guests watch their names, bottles or bags being personalised in ink. A
        memorable detail for brand activations, weddings and private celebrations.
        <Fragment slot="cta">
          <Button href="/previous-projects" variant="outline">See previous projects</Button>
        </Fragment>
      </FeatureSplit>

      <FeatureSplit
        eyebrow="From the studio"
        title="Studio orders"
        file="studio-orders.jpg"
        alt="Studio order — hand-lettered welcome card among fresh flowers"
        objectPosition="object-[65%_45%]"
        reversed
      >
        Written and finished in the studio, then delivered to your door: invitation suites, engraved
        gifts and foiled stationery, crafted at the pace good work requires.
        <Fragment slot="cta">
          <Button href="/products" variant="outline">Browse products</Button>
        </Fragment>
      </FeatureSplit>
    </div>
  </Section>

  <ProcessSteps />
  <ContactBanner id="inquiry" />
  <InstagramGrid />
</Layout>
