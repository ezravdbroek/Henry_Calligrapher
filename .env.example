# Build-time variables (copy to .env for local development; .env is git-ignored).
# Cloudflare Pages does not need any of these — the defaults in src/data/content.ts are
# the production values.

# Overrides the Turnstile site key baked into src/data/content.ts. The real widget only
# accepts henrycalligraphy.com, www.henrycalligraphy.com and henry-calligrapher.pages.dev,
# so local runs use Cloudflare's always-passing test key below. An empty value builds the
# contact form without the spam check.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
